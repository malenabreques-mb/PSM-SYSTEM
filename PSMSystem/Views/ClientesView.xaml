<UserControl x:Class="PSMSystem.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Clientes" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="+ Agregar Cliente"
                    Command="{Binding AgregarClienteCommand}" Padding="10,4" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding BuscarCommand}" Margin="8,0,0,0"/>
            <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     Width="280" HorizontalAlignment="Left"
                     ToolTip="Filtrar por nombre, apellido o teléfono">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding BuscarCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="Cargando..." Foreground="Gray" Margin="0,0,0,8"
                   Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Clientes}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="140"/>
                <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="2*"/>
                <DataGridTextColumn Header="Estado" Width="90"
                                     Binding="{Binding Activo, Converter={StaticResource BoolToEstadoConverter}}"/>
                <DataGridTemplateColumn Header="Acciones" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Padding="6,2" Margin="0,0,4,0"
                                        Command="{Binding DataContext.EditarClienteCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Padding="6,2"
                                        Command="{Binding DataContext.DesactivarReactivarClienteCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Desactivar"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                    <Setter Property="Content" Value="Reactivar"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                <Run Text="Página"/> <Run Text="{Binding PaginaActual, Mode=OneWay}"/>
                <Run Text="de"/> <Run Text="{Binding TotalPaginas, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="Siguiente ▶" Command="{Binding PaginaSiguienteCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>