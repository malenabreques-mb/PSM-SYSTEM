<UserControl x:Class="PSMSystem.Views.RepuestosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Repuestos y Stock" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="+ Agregar Repuesto"
                    Command="{Binding AgregarRepuestoCommand}" Padding="10,4" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding BuscarCommand}" Margin="8,0,0,0"/>
            <CheckBox Content="Solo con stock bajo" IsChecked="{Binding SoloStockBajo}"
                      VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     Width="220" HorizontalAlignment="Left"
                     ToolTip="Filtrar por nombre, categoría o proveedor">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding BuscarCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="Cargando..." Foreground="Gray" Margin="0,0,0,8"
                   Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBlock Grid.Row="2" Text="No hay repuestos en inventario." Foreground="Gray" Margin="0,0,0,8"
                   Visibility="{Binding SinRepuestosEnAbsoluto, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBlock Grid.Row="2" Text="No se encontraron repuestos con esos criterios." Foreground="Gray" Margin="0,0,0,8"
                   Visibility="{Binding SinResultadosFiltrados, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Repuestos}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="120"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="120"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, StringFormat={}{0:C2}}" Width="90"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}" Width="70">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" Width="70"/>
                <DataGridTextColumn Header="Estado" Width="80"
                                     Binding="{Binding Activo, Converter={StaticResource BoolToEstadoConverter}}"/>
                <DataGridTemplateColumn Header="Acciones" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Padding="6,2" Margin="0,0,4,0"
                                        Command="{Binding DataContext.EditarRepuestoCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Movimientos" Padding="6,2" Margin="0,0,4,0"
                                        Command="{Binding DataContext.VerMovimientosCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Padding="6,2"
                                        Command="{Binding DataContext.DesactivarReactivarRepuestoCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Desactivar"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                    <Setter Property="Content" Value="Reactivar"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                <Run Text="Página"/> <Run Text="{Binding PaginaActual, Mode=OneWay}"/>
                <Run Text="de"/> <Run Text="{Binding TotalPaginas, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="Siguiente ▶" Command="{Binding PaginaSiguienteCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>