<Window x:Class="PSMSystem.Views.VehiculoEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Width="380" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <TextBlock Text="Cliente"/>
        <ComboBox ItemsSource="{Binding ClientesDisponibles}"
                  DisplayMemberPath="NombreCompleto"
                  SelectedValuePath="IdCliente"
                  SelectedValue="{Binding IdClienteSeleccionado}"
                  Margin="0,2,0,10"/>

        <TextBlock Text="Marca"/>
        <TextBox Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Modelo"/>
        <TextBox Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Año"/>
        <TextBox Text="{Binding Anio, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Patente"/>
        <TextBox Text="{Binding Patente, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="90" Margin="0,0,8,0"/>
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Width="90"/>
        </StackPanel>
    </StackPanel>
</Window>