<UserControl x:Class="PSMSystem.Views.TurnosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Turnos" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="+ Agendar Turno"
                    Command="{Binding AgregarTurnoCommand}" Padding="10,4" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding BuscarCommand}" Margin="8,0,0,0"/>
            <DatePicker SelectedDate="{Binding FechaFiltro}" Width="130" Margin="8,0,0,0"/>
            <ComboBox ItemsSource="{Binding EstadosFiltro}" DisplayMemberPath="Nombre"
                      SelectedItem="{Binding EstadoFiltro}" Width="130" Margin="8,0,0,0"/>
            <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" HorizontalAlignment="Left"
                     ToolTip="Filtrar por cliente o vehículo">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding BuscarCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="Cargando..." Foreground="Gray" Margin="0,0,0,8"
                   Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Turnos}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Hora" Binding="{Binding Hora, StringFormat=HH:mm}" Width="70"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.NombreCompleto}" Width="*"/>
                <DataGridTextColumn Header="Vehículo" Binding="{Binding Vehiculo.Patente}" Width="100"/>
                <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="2*"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTurno.Nombre}" Width="100"/>
                <DataGridTemplateColumn Header="Acciones" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Padding="6,2" Margin="0,0,4,0"
                                        Command="{Binding DataContext.EditarTurnoCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Eliminar" Padding="6,2"
                                        Command="{Binding DataContext.EliminarTurnoCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                <Run Text="Página"/> <Run Text="{Binding PaginaActual, Mode=OneWay}"/>
                <Run Text="de"/> <Run Text="{Binding TotalPaginas, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="Siguiente ▶" Command="{Binding PaginaSiguienteCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>