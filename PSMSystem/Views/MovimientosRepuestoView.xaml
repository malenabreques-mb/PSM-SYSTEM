<Window x:Class="PSMSystem.Views.MovimientosRepuestoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimientos de stock"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Repuesto.Nombre}"/>
            <TextBlock>
                <Run Text="Stock actual: "/><Run Text="{Binding StockActual, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento.Nombre}" Width="100"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Nuevo movimiento" FontWeight="Bold" Margin="0,0,0,6"/>

            <TextBlock Text="Tipo"/>
            <ComboBox ItemsSource="{Binding Tipos}" DisplayMemberPath="Nombre"
                      SelectedValuePath="IdTipoMovimiento" SelectedValue="{Binding IdTipoSeleccionado}"
                      Margin="0,2,0,10"/>

            <TextBlock Text="Cantidad"/>
            <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

            <TextBlock Text="Fecha"/>
            <DatePicker SelectedDate="{Binding Fecha}" Margin="0,2,0,10"/>

            <TextBlock Text="Observación (opcional)"/>
            <TextBox Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

            <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <Button Content="+ Registrar movimiento" Command="{Binding RegistrarCommand}"
                    HorizontalAlignment="Left" Padding="10,4"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cerrar" Command="{Binding CerrarCommand}" Width="90"/>
        </StackPanel>
    </Grid>
</Window>