<UserControl x:Class="PSMSystem.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Historial de Reparaciones" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding BuscarCommand}" Margin="8,0,0,0"/>
            <DatePicker SelectedDate="{Binding FechaFiltro}" Width="130" Margin="8,0,0,0"/>
            <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" HorizontalAlignment="Left"
                     ToolTip="Filtrar por cliente, vehículo o número de orden">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding BuscarCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="Cargando..." Foreground="Gray" Margin="0,0,0,8"
                   Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBlock Grid.Row="2" Text="No se encontraron reparaciones." Foreground="Gray" Margin="0,0,0,8"
                   Visibility="{Binding SinResultados, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Ordenes}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding IdOrdenTrabajo}" Width="40"/>
                <DataGridTextColumn Header="Ingreso" Binding="{Binding FechaIngreso, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.NombreCompleto}" Width="*"/>
                <DataGridTextColumn Header="Vehículo" Binding="{Binding Vehiculo.Patente}" Width="90"/>
                <DataGridTextColumn Header="Motivo" Binding="{Binding MotivoIngreso}" Width="2*"/>
                <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Ver detalle" Padding="6,2"
                                    Command="{Binding DataContext.VerDetalleCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                <Run Text="Página"/> <Run Text="{Binding PaginaActual, Mode=OneWay}"/>
                <Run Text="de"/> <Run Text="{Binding TotalPaginas, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="Siguiente ▶" Command="{Binding PaginaSiguienteCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>