<Window x:Class="PSMSystem.Views.FacturaDetalleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de factura"
        Width="540" Height="800"
        WindowStartupLocation="CenterOwner">
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Margin="0,0,0,12">
				<TextBlock FontSize="16" FontWeight="Bold">
					<Run Text="Factura "/>
					<Run Text="{Binding NumeroFactura, Mode=OneWay}"/>
				</TextBlock>
				<TextBlock Text="{Binding ClienteYVehiculo}" Foreground="Gray"/>
				<TextBlock Text="{Binding EstadoActual}" FontWeight="Bold" Margin="0,4,0,0"/>
			</StackPanel>

			<DataGrid Grid.Row="1" ItemsSource="{Binding Detalles}" AutoGenerateColumns="False"
					  IsReadOnly="True" CanUserAddRows="False" MaxHeight="220">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Tipo" Binding="{Binding TipoItem}" Width="90"/>
					<DataGridTextColumn Header="Ítem" Binding="{Binding ItemDescripcion}" Width="*"/>
					<DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="50"/>
					<DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, StringFormat={}{0:C2}}" Width="90"/>
					<DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C2}}" Width="90"/>
					<DataGridTemplateColumn Header="" Width="150">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<Button Content="Editar" Padding="4,2" Margin="0,0,4,0"
											IsEnabled="{Binding DataContext.PendienteDeEmision, RelativeSource={RelativeSource AncestorType=Window}}"
											Command="{Binding DataContext.IniciarEdicionCantidadCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
											CommandParameter="{Binding}"/>
									<Button Content="Quitar" Padding="4,2"
											IsEnabled="{Binding DataContext.PendienteDeEmision, RelativeSource={RelativeSource AncestorType=Window}}"
											Command="{Binding DataContext.EliminarItemCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
											CommandParameter="{Binding}"/>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>

			<Border Grid.Row="2" Margin="0,10,0,0" Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
					Visibility="{Binding EstaEditandoCantidad, Converter={StaticResource BoolToVisibilityConverter}}">
				<StackPanel>
					<TextBlock Text="Editar cantidad" FontWeight="Bold" Margin="0,0,0,6"/>
					<TextBlock Text="{Binding DetalleEnEdicion.ItemDescripcion, Mode=OneWay}" Foreground="Gray" Margin="0,0,0,6"/>

					<TextBlock Text="Nueva cantidad"/>
					<TextBox Text="{Binding NuevaCantidad, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

					<StackPanel Orientation="Horizontal">
						<Button Content="Guardar" Command="{Binding GuardarCantidadCommand}" Padding="10,4" Margin="0,0,8,0"/>
						<Button Content="Cancelar" Command="{Binding CancelarEdicionCantidadCommand}" Padding="10,4"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<TextBlock Grid.Row="3" Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>

			<StackPanel Grid.Row="4" Margin="0,12,0,0" Visibility="{Binding PendienteDeEmision, Converter={StaticResource BoolToVisibilityConverter}}">
				<TextBlock Text="Agregar ítem" FontWeight="Bold" Margin="0,0,0,6"/>

				<TextBlock Text="Tipo"/>
				<ComboBox ItemsSource="{Binding TiposItem}" SelectedItem="{Binding TipoItemSeleccionado}" Margin="0,2,0,10"/>

				<StackPanel Visibility="{Binding EsRepuesto, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock Text="Repuesto"/>
					<ComboBox ItemsSource="{Binding RepuestosDisponibles}" DisplayMemberPath="DescripcionCombo"
							  SelectedValuePath="IdRepuesto" SelectedValue="{Binding IdRepuestoSeleccionado}"
							  Margin="0,2,0,10"/>
				</StackPanel>

				<StackPanel Visibility="{Binding EsRepuesto, Converter={StaticResource InverseBoolToVisibilityConverter}}">
					<TextBlock Text="Descripción del trabajo"/>
					<TextBox Text="{Binding DescripcionItem, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>
				</StackPanel>

				<TextBlock Text="Cantidad"/>
				<TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

				<TextBlock Text="Precio unitario"/>
				<TextBox Text="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

				<Button Content="+ Agregar ítem" Command="{Binding AgregarItemCommand}"
						HorizontalAlignment="Left" Padding="10,4"/>
			</StackPanel>

			<StackPanel Grid.Row="5" Margin="0,12,0,0" Visibility="{Binding PendienteDePago, Converter={StaticResource BoolToVisibilityConverter}}">
				<TextBlock Text="Registrar pago" FontWeight="Bold" Margin="0,0,0,6"/>

				<TextBlock Text="Medio de pago"/>
				<ComboBox ItemsSource="{Binding MediosDePago}" SelectedItem="{Binding MedioPagoSeleccionado}" Margin="0,2,0,10"/>

				<TextBlock Text="Monto"/>
				<TextBox Text="{Binding MontoPago, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

				<Button Content="$ Registrar pago" Command="{Binding RegistrarPagoCommand}"
						HorizontalAlignment="Left" Padding="10,4"/>

				<ItemsControl ItemsSource="{Binding Pagos}" Margin="0,10,0,0">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock Foreground="Gray">
								<Run Text="{Binding Fecha, StringFormat=dd/MM/yyyy, Mode=OneWay}"/>
								<Run Text=" - "/>
								<Run Text="{Binding MedioPago, Mode=OneWay}"/>
								<Run Text=" - "/>
								<Run Text="{Binding Monto, StringFormat={}{0:C2}, Mode=OneWay}"/>
							</TextBlock>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<Grid Grid.Row="6" Margin="0,12,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock>
						<Run Text="Subtotal: "/>
						<Run Text="{Binding Subtotal, StringFormat={}{0:C2}, Mode=OneWay}"/>
					</TextBlock>
					<TextBlock>
						<Run Text="IVA (21%): "/>
						<Run Text="{Binding Iva, StringFormat={}{0:C2}, Mode=OneWay}"/>
					</TextBlock>
					<TextBlock FontWeight="Bold" FontSize="14">
						<Run Text="Total: "/>
						<Run Text="{Binding Total, StringFormat={}{0:C2}, Mode=OneWay}"/>
					</TextBlock>

					<StackPanel Margin="0,4,0,0" Visibility="{Binding PendienteDeEmision, Converter={StaticResource InverseBoolToVisibilityConverter}}">
						<TextBlock>
							<Run Text="Total pagado: "/>
							<Run Text="{Binding TotalPagado, StringFormat={}{0:C2}, Mode=OneWay}"/>
						</TextBlock>
						<TextBlock FontWeight="Bold">
							<Run Text="Saldo pendiente: "/>
							<Run Text="{Binding SaldoPendiente, StringFormat={}{0:C2}, Mode=OneWay}"/>
						</TextBlock>
					</StackPanel>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
					<Button Content="Emitir Factura" Command="{Binding EmitirCommand}" Padding="10,4" Margin="0,0,8,0"
							Visibility="{Binding PendienteDeEmision, Converter={StaticResource BoolToVisibilityConverter}}"/>
					<Button Content="Cerrar" Command="{Binding CerrarCommand}" Width="90"/>
				</StackPanel>
			</Grid>
		</Grid>
	</ScrollViewer>
</Window>